<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppMinhasCompras.Views.ListaProduto"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MauiAppMinhasCompras.Models"
    Title="Meus produtos">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Novo"
            Clicked="AbrirCadastro" />
    </ContentPage.ToolbarItems>

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="12">

        <Label
            Grid.Row="0"
            Text="Lista de Compras do João"
            FontSize="25"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <!-- O TextChanged pesquisa a cada letra digitada. -->
        <SearchBar
            x:Name="barraPesquisa"
            Grid.Row="1"
            Placeholder="Pesquisar produto"
            TextChanged="PesquisarProduto" />

        <!-- A lista recebe os dados da ObservableCollection. -->
        <CollectionView
            x:Name="listaProdutos"
            Grid.Row="2"
            EmptyView="Nenhum produto encontrado.">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Produto">

                    <Border
                        Padding="12"
                        Margin="0,0,0,8"
                        Stroke="#BDBDBD"
                        StrokeThickness="1">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto">

                            <Label
                                Grid.Row="0"
                                Text="{Binding Descricao}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Grid.Row="1"
                                Text="{Binding Quantidade, StringFormat='Quantidade: {0:F2}'}" />

                            <Label
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Text="{Binding Total, StringFormat='Total: R$ {0:F2}'}"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>